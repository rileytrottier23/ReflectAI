# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# Bearer token for /mcp — must match the client secret you register in Claude
MCP_TOKEN=change-me-to-a-long-random-string

# Owner identity — used as the userId in the in-memory store
MCP_USER_EMAIL=you@example.com

# OAuth client credentials — enter these in Claude's connector UI
OAUTH_CLIENT_ID=claude

# Port (optional, defaults to 3000)
# PORT=3000
